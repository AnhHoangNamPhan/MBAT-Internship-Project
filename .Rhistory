# Load data
stocks <- read.csv("SampleI.csv")
market <- read.csv("Market.csv")
dates <- stocks[,1]
returns <- stocks[,-1]
# Standardize
returns_std <- scale(returns)
pca <- prcomp(returns_std, center = TRUE, scale. = TRUE)
summary(pca)  # to see variance explained
loadings <- pca$rotation[,1]        # PC1 loadings
stock_ids <- colnames(returns)
industries <- substr(stock_ids,1,1)
df_loadings <- data.frame(
Stock = stock_ids,
Industry = industries,
Loading_PC1 = loadings
)
# Aggregate by industry
library(dplyr)
industry_risk <- df_loadings %>%
group_by(Industry) %>%
summarise(
Mean_Loading = mean(Loading_PC1),
Abs_Mean_Loading = mean(abs(Loading_PC1)),
SD_Loading = sd(Loading_PC1)
)
