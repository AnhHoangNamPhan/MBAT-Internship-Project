main = "Generalization Gap vs Training Size (d = 10)")
E_in_logreg_reg <- function(X, y, w, lambda) {
# Linear combination
z <- X %*% w
# Cross-entropy loss for y in {-1, 1}
ce_error <- mean(log(1 + exp(-y * z)))
# Ridge penalty term
penalty <- lambda * sum(w^2)
# Total error
E_in <- ce_error + penalty
return(E_in)
}
g_E_in_logreg_reg <- function(X, y, w, lambda) {
# Compute linear predictions
z <- X %*% w
# Compute the gradient of cross-entropy for y in {-1, 1}
grad_ce <- -t(X) %*% (y / (1 + exp(y * z))) / nrow(X)
# Gradient of ridge penalty
grad_ridge <- 2 * lambda * w
# Total gradient
return(grad_ce + grad_ridge)
}
batch_SGD <- function(X, y, E_in, g_E_in, w_0, eta, batch_size, epochs) {
N <- nrow(X)
w <- w_0
E_trace <- numeric(epochs) # Store E_in after each epoch
for (epoch in 1:epochs) {
indices <- sample(1:N)
for (start_idx in seq(1, N, by = batch_size)) {
end_idx <- min(start_idx + batch_size - 1, N)
batch_indices <- indices[start_idx:end_idx]
X_batch <- X[batch_indices, , drop = FALSE]
y_batch <- y[batch_indices]
grad <- g_E_in(X_batch, y_batch, w)
w <- w - eta * grad
}
# Track E_in using the full dataset
E_trace[epoch] <- E_in(X, y, w)
}
# Return both final weights and the error trace
return(list(w = w, E_trace = E_trace))
}
set.seed(1900)
N <- 200
d <- 3
l <- -5; u <- 5
w_true <- matrix(c(-3, rep(1, d-1)), ncol = 1)
X0 <- matrix(runif((d-1) * N, l, u), ncol = d-1)
X <- cbind(1, X0)
# Compute linear combination (logits)
z <- X %*% w_true
set.seed(1)
# Compute probabilities using sigmoid function
probs <- 1 / (1 + exp(-z))
# Generate binary outcomes from Bernoulli(probs)
y_binary <- rbinom(N, 1, probs)
# Convert from {0, 1} to {-1, 1}
y <- 2 * y_binary - 1
# Preview a few values
head(y)
lambda <- 0.1 / N
batch_size <- N
set.seed(1)
eta_values <- c(0.001, 0.01, 0.05, 0.1)
epoch_values <- c(50, 100, 200)
results <- list()
for (eta in eta_values) {
for (epochs in epoch_values) {
start_time <- Sys.time()
result <- batch_SGD(
X = X,
y = y,
E_in = function(X, y, w) E_in_logreg_reg(X, y, w, lambda),
g_E_in = function(X, y, w) g_E_in_logreg_reg(X, y, w, lambda),
w_0 = matrix(0, nrow = ncol(X), ncol = 1),
eta = eta,
batch_size = batch_size,
epochs = epochs
)
end_time <- Sys.time()
results[[paste("eta", eta, "epochs", epochs)]] <- list(
w = result$w,
E_trace = result$E_trace,
time = end_time - start_time
)
}
}
library(ggplot2)
# Convert to a data frame
plot_data <- data.frame()
for (key in names(results)) {
trace <- results[[key]]$E_trace
df <- data.frame(
Epoch = 1:length(trace),
E_in = trace,
Setting = key
)
plot_data <- rbind(plot_data, df)
}
# Plot
ggplot(plot_data, aes(x = Epoch, y = E_in, color = Setting)) +
geom_line() +
labs(title = "Convergence of E_in over Epochs",
y = "In-Sample Error (E_in)",
x = "Epoch")
#Find the fastest run time
times <- sapply(results, function(res) res$time)
sorted_times <- sort(times)
print(sorted_times)
for (key in names(results)) {
w_star <- results[[key]]$w
dist <- sqrt(sum((w_star - w_true)^2))
cat("Setting:", key, " | Distance to w_true:", round(dist, 4), "\n")
}
distances <- sapply(results, function(res) sqrt(sum((res$w - w_true)^2)))
best_key <- names(which.min(distances))
cat("Best match to w_true:", best_key, "\n")
# Define SGD settings
batch_size <- 1  # Vanilla stochastic gradient descent
eta_values <- c(0.001, 0.01, 0.05, 0.1)
epoch_values <- c(50, 100, 200)
set.seed(1)
results_sgd <- list()
# Run SGD for each combination
for (eta in eta_values) {
for (epochs in epoch_values) {
start_time <- Sys.time()
result <- batch_SGD(
X = X,
y = y,
E_in = function(X, y, w) E_in_logreg_reg(X, y, w, lambda),
g_E_in = function(X, y, w) g_E_in_logreg_reg(X, y, w, lambda),
w_0 = matrix(0, nrow = ncol(X), ncol = 1),
eta = eta,
batch_size = batch_size,
epochs = epochs
)
end_time <- Sys.time()
time_elapsed <- end_time - start_time
# Save results
key <- paste("eta", eta, "epochs", epochs)
results_sgd[[key]] <- list(
w = result$w,
E_trace = result$E_trace,
time = time_elapsed
)
}
}
# Convert SGD results into a data frame for plotting
plot_data_sgd <- data.frame()
for (key in names(results_sgd)) {
trace <- results_sgd[[key]]$E_trace
df <- data.frame(
Epoch = 1:length(trace),
E_in = trace,
Setting = key
)
plot_data_sgd <- rbind(plot_data_sgd, df)
}
# Plot the convergence curves for SGD
ggplot(plot_data_sgd, aes(x = Epoch, y = E_in, color = Setting)) +
geom_line() +
labs(
title = "Convergence of E_in over Epochs (SGD)",
y = "In-Sample Error (E_in)",
x = "Epoch"
)
# Find the fastest run time
times_sgd <- sapply(results_sgd, function(res) res$time)
sorted_times_sgd <- sort(times_sgd)
print(sorted_times_sgd)
for (key in names(results_sgd)) {
w_star <- results_sgd[[key]]$w
dist <- sqrt(sum((w_star - w_true)^2))
cat("Setting:", key, " | Distance to w_true:", round(dist, 4), "\n")
}
distances_sgd <- sapply(results_sgd, function(res) sqrt(sum((res$w - w_true)^2)))
best_key_sgd <- names(which.min(distances_sgd))
cat("Best SGD match to w_true:", best_key_sgd, "\n")
