result <- batch_SGD(
X = X,
y = y,
E_in = function(X, y, w) E_in_logreg_reg(X, y, w, lambda),
g_E_in = function(X, y, w) g_E_in_logreg_reg(X, y, w, lambda),
w_0 = matrix(0, nrow = ncol(X), ncol = 1),
eta = eta,
batch_size = batch_size,
epochs = epochs
)
end_time <- Sys.time()
key <- paste("batch", batch_size, "eta", eta, "epochs", epochs)
results_batch[[key]] <- list(
w = result$w,
E_trace = result$E_trace,
time = end_time - start_time
)
}
}
}
