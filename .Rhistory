binary_data_generation <- function(N, d){
bin_class_data <- tibble(y = c(rep(-1, ceiling(N/2)), rep(1, floor(N/2))),
x1 = c(rnorm(ceiling(N/2), 0.5, 1), rnorm(floor(N/2), -0.5, 1)),
x2 = c(rnorm(ceiling(N/2), -0.5, 1), rnorm(floor(N/2), 0.5, 1))
)
if(d > 2){
for(j in 3:d){
bin_class_data[paste0("x",j)] = rnorm(N, 0, 1)
}
}
return(bin_class_data)
}
set.seed(1)
# Generate test set (N = 10000) and training set (N = 10)
test_set <- binary_data_generation(N = 10000, d = 4)
train_set <- binary_data_generation(N = 10, d = 4)
set.seed(1)
# Run pocket_PLA on training set
result_2 <- pocket_PLA(X = as.matrix(train_set[, -1]),  # exclude y
y = train_set$y,
max_iter = 1000)
# Extract best weights from the result
best_w <- result_2$best_weights
# Add Bias to the Data Matrices
X_train_aug <- cbind(1, as.matrix(train_set[, -1]))
X_test_aug  <- cbind(1, as.matrix(test_set[, -1]))
# Make Predictions on training and test sets
train_preds <- sign(X_train_aug %*% best_w)
test_preds  <- sign(X_test_aug  %*% best_w)
# Calculate classification error
Ein  <- mean(train_preds != train_set$y)
Eout <- mean(test_preds != test_set$y)
Ein
Eout
set.seed(1)
# Create test set once
test_set <- binary_data_generation(N = 10000, d = 4)
X_test_aug <- cbind(1, as.matrix(test_set[, -1]))
# Initialize vector to store differences
diff_errors <- numeric(100)
for (i in 1:100) {
# Generate new training set
train_set <- binary_data_generation(N = 10, d = 4)
X_train_aug <- cbind(1, as.matrix(train_set[, -1]))
# Run pocket_PLA
result <- pocket_PLA(X = as.matrix(train_set[, -1]), y = train_set$y, max_iter = 1000)
best_w <- result$best_weights
# Predictions
train_preds <- sign(X_train_aug %*% best_w)
test_preds <- sign(X_test_aug %*% best_w)
# Compute Ein and Eout
Ein <- mean(train_preds != train_set$y)
Eout <- mean(test_preds != test_set$y)
# Store difference
diff_errors[i] <- abs(Ein - Eout)
}
# Plot histogram of differences
hist(diff_errors, main = "Difference between Eout and Ein (100 runs)",
xlab = "|Eout - Ein|", col = "skyblue", breaks = 20)
# Estimate P(|Eout - Ein| > 0.1)
mean(diff_errors > 0.1)
set.seed(42)
# Define training sizes
N_train_values <- c(10, 20, 50, 75, 100, 125, 150)
n_runs <- 100
d <- 4
# Store probabilities for each training size
prob_diff_gt_0.1 <- numeric(length(N_train_values))
# Run simulation
for (i in seq_along(N_train_values)) {
N <- N_train_values[i]
diff_errors <- numeric(n_runs)
for (j in 1:n_runs) {
train_set <- binary_data_generation(N = N, d = d)
test_set <- binary_data_generation(N = 10000, d = d)
result <- pocket_PLA(X = as.matrix(train_set[, -1]),
y = train_set$y,
max_iter = 1000)
best_w <- result$best_weights
X_train_aug <- cbind(1, as.matrix(train_set[, -1]))
X_test_aug <- cbind(1, as.matrix(test_set[, -1]))
train_preds <- sign(X_train_aug %*% best_w)
test_preds <- sign(X_test_aug %*% best_w)
Ein <- mean(train_preds != train_set$y)
Eout <- mean(test_preds != test_set$y)
diff_errors[j] <- abs(Eout - Ein)
}
prob_diff_gt_0.1[i] <- mean(diff_errors > 0.1)
}
# Plot N_train vs probability
plot(N_train_values, prob_diff_gt_0.1, type = "b", col = "blue",
xlab = "Training Set Size (N_train)",
ylab = "P(|Eout - Ein| > 0.1)",
main = "Generalization Gap vs Training Size (d=4)")
set.seed(1)
# Increase dimensionality
d_high <- 10
N_train_values_high_d <- c(10, 30, 50, 75, 100, 150, 200, 250, 300)
prob_diff_gt_0.1_high_d <- numeric(length(N_train_values_high_d))
n_runs <- 100
# Repeat simulation for each training size
for (i in seq_along(N_train_values_high_d)) {
N <- N_train_values_high_d[i]
