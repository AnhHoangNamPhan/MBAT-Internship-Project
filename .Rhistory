ggplot(plot_data, aes(x = Epoch, y = E_in, color = Setting)) +
geom_line() +
labs(title = "Convergence of E_in over Epochs",
y = "In-Sample Error (E_in)",
x = "Epoch")
#Find the fastest run time
times <- sapply(results, function(res) res$time)
sorted_times <- sort(times)
print(sorted_times)
for (key in names(results)) {
w_star <- results[[key]]$w
dist <- sqrt(sum((w_star - w_true)^2))
cat("Setting:", key, " | Distance to w_true:", round(dist, 4), "\n")
}
distances <- sapply(results, function(res) sqrt(sum((res$w - w_true)^2)))
best_key <- names(which.min(distances))
cat("Best match to w_true:", best_key, "\n")
# Define SGD settings
batch_size <- 1  # Vanilla stochastic gradient descent
eta_values <- c(0.001, 0.01, 0.05, 0.1)
epoch_values <- c(50, 100, 200)
set.seed(1)
results_sgd <- list()
# Run SGD for each combination
for (eta in eta_values) {
for (epochs in epoch_values) {
start_time <- Sys.time()
result <- batch_SGD(
X = X,
y = y,
E_in = function(X, y, w) E_in_logreg_reg(X, y, w, lambda),
g_E_in = function(X, y, w) g_E_in_logreg_reg(X, y, w, lambda),
w_0 = matrix(0, nrow = ncol(X), ncol = 1),
eta = eta,
batch_size = batch_size,
epochs = epochs
)
end_time <- Sys.time()
time_elapsed <- end_time - start_time
# Save results
key <- paste("eta", eta, "epochs", epochs)
results_sgd[[key]] <- list(
w = result$w,
E_trace = result$E_trace,
time = time_elapsed
)
}
}
# Convert SGD results into a data frame for plotting
plot_data_sgd <- data.frame()
for (key in names(results_sgd)) {
trace <- results_sgd[[key]]$E_trace
df <- data.frame(
Epoch = 1:length(trace),
E_in = trace,
Setting = key
)
plot_data_sgd <- rbind(plot_data_sgd, df)
}
# Plot the convergence curves for SGD
ggplot(plot_data_sgd, aes(x = Epoch, y = E_in, color = Setting)) +
geom_line() +
labs(
title = "Convergence of E_in over Epochs (SGD)",
y = "In-Sample Error (E_in)",
x = "Epoch"
)
# Find the fastest run time
times_sgd <- sapply(results_sgd, function(res) res$time)
sorted_times_sgd <- sort(times_sgd)
print(sorted_times_sgd)
for (key in names(results_sgd)) {
w_star <- results_sgd[[key]]$w
dist <- sqrt(sum((w_star - w_true)^2))
cat("Setting:", key, " | Distance to w_true:", round(dist, 4), "\n")
}
distances_sgd <- sapply(results_sgd, function(res) sqrt(sum((res$w - w_true)^2)))
best_key_sgd <- names(which.min(distances_sgd))
cat("Best SGD match to w_true:", best_key_sgd, "\n")
# Setup
batch_sizes <- c(1, 5, 10, 50, 100, N)
eta_values <- c(0.001, 0.01, 0.05, 0.1)
epoch_values <- c(50, 100, 200)
lambda <- 0.1 / N
set.seed(1)
results_batch <- list()
# Grid search
for (batch_size in batch_sizes) {
for (eta in eta_values) {
for (epochs in epoch_values) {
start_time <- Sys.time()
result <- batch_SGD(
X = X,
y = y,
E_in = function(X, y, w) E_in_logreg_reg(X, y, w, lambda),
g_E_in = function(X, y, w) g_E_in_logreg_reg(X, y, w, lambda),
w_0 = matrix(0, nrow = ncol(X), ncol = 1),
eta = eta,
batch_size = batch_size,
epochs = epochs
)
end_time <- Sys.time()
key <- paste("batch", batch_size, "eta", eta, "epochs", epochs)
results_batch[[key]] <- list(
w = result$w,
E_trace = result$E_trace,
time = end_time - start_time
)
}
}
}
# Format plot data
plot_data <- data.frame()
for (key in names(results_batch)) {
trace <- results_batch[[key]]$E_trace
df <- data.frame(
Epoch = 1:length(trace),
E_in = trace,
Setting = key
)
plot_data <- rbind(plot_data, df)
}
# Plot
ggplot(plot_data, aes(x = Epoch, y = E_in, color = Setting)) +
geom_line(alpha = 0.7) +
labs(title = "Convergence of E_in over Epochs (Various Batch Sizes)",
y = "In-Sample Error (E_in)",
x = "Epoch")
